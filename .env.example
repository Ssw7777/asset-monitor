# Required
DASHBOARD_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=replace-with-long-random-string-at-least-32-chars

# Optional FX rate (also editable in UI and persisted in store)
USD_CNY_RATE=6.66

# --- Persistence (Vercel / serverless) ---
# Prefer Turso (libSQL). Free tier works well for this kv store.
# Create DB at https://turso.tech then set:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Without Turso: in-memory + /tmp/store.json (ephemeral across cold starts).
# Local `next dev` always uses data/store.json on disk.

# Optional: AES-256-GCM key for storing CEX credentials encrypted in DB
# Use 64 hex chars (32 bytes) OR any passphrase (hashed with SHA-256)
ENCRYPTION_KEY=

# OKX read-only (env preferred; can also save encrypted via /api/cex-keys)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SIMULATED=0

# Binance read-only
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Web3 Developer Portal (DeFi / Wallet / Market only — never Trade/Transaction).
# Primary source for EVM wallet totals and DeFi positions.
# Published total = filtered tokens + app balances + DeFi not already in the token list.
# The first Binance publish waits until one paced Rabby token list is stored.
# Rabby total_balance is only a once-per-day reconciliation check.
# Optional extra tokens to keep: comma-separated chain:symbol or chain:0xcontract
# BN_WALLET_TOKEN_ALLOWLIST=bsc:U,arb:sUSDai,base:NVDAc
# Not the same as BINANCE_API_KEY above (exchange).
BN_WEB3_API_KEY=
BN_WEB3_API_SECRET=

# Gate read-only. Primary account. Env wins over keys saved via /api/cex-keys.
# Read-only total_balance only (spot + finance/earn). No trade permission.
GATE_API_KEY=
GATE_API_SECRET=

# Optional extra read-only Gate accounts (Gate B / Gate C). Both values must be set or that account is skipped.
# Leave blank to hide the row. Do not commit real keys.
# After a successful read, manual rows named 「Gate B GHO」 / 「Gate C GHO」 are removed.
GATE_B_KEY=
GATE_B_SECRET=
GATE_C_KEY=
GATE_C_SECRET=

# Bitget read-only
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# 可选的付费增强项；当前免费生产方案不需要配置，也不会主动申请。
# 仅为兼容已有部署保留变量名。
DEBANK_ACCESS_KEY=

# Zerion 仅用于低频校准普通代币的数量、价格、图标和所属链。
# 每轮最多请求 1 个地址；同一地址 3 小时内最多尝试 1 次，25 个地址约 200 次/天；
# 请求失败也进入 3 小时冷却。钱包总额、Kona、快照和资金流水不依赖 Zerion。
ZERION_API_KEY=

# --- 云端定时扫描（用于每 5 分钟刷新、记录快照和资金变动） ---
# Vercel Hobby 每日兜底一次；GitHub Actions 或其他可信云端定时器每 5 分钟调用：
#   GET /api/cron/refresh?mode=auto
# 请求必须携带 Authorization: Bearer <CRON_SECRET>。
# 未配置时，只有已登录的浏览器会话能触发刷新。
CRON_SECRET=
# Optional GitHub OIDC (advanced). Prefer CRON_SECRET on localhost.
# CRON_OIDC_AUDIENCES=https://example.com
# CRON_OIDC_TRUSTED_WORKFLOWS=[]

# Deploy note: vercel.json pins serverless to hkg1 (Hong Kong) for Binance API access.
# Optional Asia fallback: change regions to ["sin1"] if needed.
